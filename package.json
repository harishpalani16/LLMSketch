{
  "name": "sketch-to-solid",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node tools/run-smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/three": "^0.185.4",
    "puppeteer-core": "^25.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "description": "Sketch strokes in 3D and turn them into real B-rep solids, backed by OpenCascade and a parametric history graph.",
  "license": "MIT"
}
